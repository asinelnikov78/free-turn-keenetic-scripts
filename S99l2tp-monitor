#!/bin/sh

# ==============================================================================
# S99l2tp-monitor - Мониторинг с дублированием последних 100 строк лога для веб
# ==============================================================================

ENABLED=yes
PROCS=l2tp-monitor
DESC="L2TP Monitor for free-turn-proxy + WireGuard"
PATH=/opt/sbin:/opt/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PIDFILE=/var/run/l2tp-monitor.pid

VK_SCRIPT="/opt/etc/VK-Turn/vk-turn"
LOG_FILE="/opt/etc/VK-Turn/logs/l2tp-monitor.log"
WEB_LOG_FILE="/opt/share/www/cgi-bin/web-tail.log"
WEB_STATUS_FILE="/opt/var/mon_web_status.txt"
CHECK_INTERVAL=5

L2TP_SYS_NAME="L2TP0"
WG_IFACE="Wireguard0"

mkdir -p "/opt/etc/VK-Turn/logs" 2>/dev/null

log() {
    # Пишем в основной лог
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"

    # Сразу дублируем запись в веб-папку и обрезаем до 15 строк
    tail -n 15 "$LOG_FILE" > "$WEB_LOG_FILE" 2>/dev/null
    chmod 644 "$WEB_LOG_FILE" 2>/dev/null
}

check_l2tp() {
    STATUS=$(curl -s http://localhost:79/rci/show/interface/$L2TP_SYS_NAME | grep -A 5 '"summary":' | grep -o '"link": *"[^"]*"' | cut -d'"' -f4)
    [ "$STATUS" = "running" ] && return 0
    return 1
}

is_vk_running() {
    if [ -f "/opt/etc/VK-Turn/run/vk-turn.pid" ]; then
        pid=$(cat "/opt/etc/VK-Turn/run/vk-turn.pid" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
    fi
    return 1
}

is_wg_running() {
    STATUS=$(curl -s http://localhost:79/rci/show/interface/$WG_IFACE | grep -o '"state": *"[^"]*"' | cut -d'"' -f4)
    [ "$STATUS" = "up" ] && return 0
    return 1
}

save_web_status() {
    WG_JSON=$(curl -s http://localhost:79/rci/show/interface/$WG_IFACE)
    WG_LINK=$(echo "$WG_JSON" | grep -o '"link": *"[^"]*"' | cut -d'"' -f4)
    WG_CONN=$(echo "$WG_JSON" | grep -o '"connected": *"[^"]*"' | cut -d'"' -f4)
    WG_STATE=$(echo "$WG_JSON" | grep -o '"state": *"[^"]*"' | cut -d'"' -f4)

    [ -z "$WG_LINK" ] && WG_LINK="down"
    [ -z "$WG_CONN" ] && WG_CONN="no"
    [ -z "$WG_STATE" ] && WG_STATE="down"

    # Вытаскиваем последние 10 строк оригинального лога и экранируем спецсимволы
    if [ -f "$LOG_FILE" ]; then
        RAW_LOGS=$(tail -n 100 "$LOG_FILE" 2>/dev/null | awk '{line[NR]=$0} END {for (i=NR;i>0;i--) print line[i]}')
    else
        RAW_LOGS="Лог-файл автоматики еще не создан."
    fi

    {
        if check_l2tp; then echo "L2TP=up"; else echo "L2TP=down"; fi
        if is_vk_running; then echo "VK=up"; else echo "VK=down"; fi
        if [ "$WG_STATE" = "up" ]; then echo "WG=up"; else echo "WG=down"; fi
        
        echo "WG_L=$WG_LINK"
        echo "WG_C=$WG_CONN"
        echo "WG_S=$WG_STATE"
        
        # Записываем логи в файл статуса в виде безопасного блока данных HTML
        echo "WEB_LOGS=\"$RAW_LOGS\""
    } > "$WEB_STATUS_FILE"
}

start_wireguard() {
    if is_wg_running; then return 0; fi
    log "🔐 Запуск WireGuard ($WG_IFACE)..."
    /opt/sbin/ndmq -p "interface $WG_IFACE up" > /dev/null 2>&1
    sleep 2
}

stop_wireguard() {
    if ! is_wg_running; then return 0; fi
    log "🔒 Остановка WireGuard ($WG_IFACE)..."
    /opt/sbin/ndmq -p "interface $WG_IFACE down" > /dev/null 2>&1
    sleep 1
}

monitor_cycle() {
    log "=== ЗАПУСК МОНИТОРИНГА ==="
    log "Контроль: $L2TP_SYS_NAME | Связка: vk-turn ➔ $WG_IFACE"
    
    LAST_STATE=-1

    while true; do
        save_web_status
        if check_l2tp; then
            if [ "$LAST_STATE" -ne 1 ]; then
                log "🔄 L2TP поднялся ($L2TP_SYS_NAME). Отключаем резервную связку."
                LAST_STATE=1
            fi
            stop_wireguard
            if is_vk_running; then
                log "⏹️ Останавливаем vk-turn"
                "$VK_SCRIPT" stop > /dev/null 2>&1
            fi
        else
            if [ "$LAST_STATE" -ne 0 ]; then
                log "⚠️ L2TP упал ($L2TP_SYS_NAME). Запуск резервной связки по инструкции."
                LAST_STATE=0
            fi
            if ! is_vk_running; then
                log "▶️ Шаг 1: Запускаем vk-turn"
                "$VK_SCRIPT" start > /dev/null 2>&1
                sleep 4
            fi
            if is_vk_running; then
                start_wireguard
            fi
        fi
        sleep "$CHECK_INTERVAL"
    done
}

start() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
        rm -f "$PIDFILE"
    fi

    echo "🚀 Запуск L2TP монитора..."
    monitor_cycle &
    echo $! > "$PIDFILE"

    # Создаем стартовую запись для веб-панели
    log "✅ Мониторинг сети успешно запущен и работает"
    return 0
}

stop() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    rm -f "$WEB_STATUS_FILE"
    return 0
}

status() {
    WG_JSON=$(curl -s http://localhost:79/rci/show/interface/$WG_IFACE)
    WG_LINK=$(echo "$WG_JSON" | grep -o '"link": *"[^"]*"' | cut -d'"' -f4)
    WG_CONN=$(echo "$WG_JSON" | grep -o '"connected": *"[^"]*"' | cut -d'"' -f4)
    WG_STATE=$(echo "$WG_JSON" | grep -o '"state": *"[^"]*"' | cut -d'"' -f4)
    
    [ -z "$WG_LINK" ] && WG_LINK="down"
    [ -z "$WG_CONN" ] && WG_CONN="no"
    [ -z "$WG_STATE" ] && WG_STATE="down"

    echo "========================================"
    echo "    СТАТУС L2TP МОНИТОРА"
    echo "========================================"
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then echo "✅ МОНИТОР ЗАПУЩЕН"; else echo "❌ МОНИТОР НЕ ЗАПУЩЕН"; fi
    echo "📡 L2TP туннель ($L2TP_SYS_NAME): $(check_l2tp && echo "✅ АКТИВЕН" || echo "❌ НЕ АКТИВЕН")"
    echo "🔄 vk-turn:                   $(is_vk_running && echo "✅ ЗАПУЩЕН" || echo "❌ ОСТАНОВЛЕН")"
    echo "🔐 WireGuard ($WG_IFACE):      $(is_wg_running && echo "✅ ЗАПУЩЕН" || echo "❌ ОСТАНОВЛЕН")"
    echo "    ├─ link:       $WG_LINK"
    echo "    ├─ connected:  $WG_CONN"
    echo "    └─ state:      $WG_STATE"
    echo "========================================"
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) stop; sleep 1; start ;;
    status) status ;;
esac